<?xml version="1.0" encoding="utf-8"?>
<!-- Nen icon adaptive: gradient toa tron tu tim dam (giua) ra gan den
     (mep ngoai) - tao cam giac "hao quang" phia sau cac goc ngam QR va nut
     ban phim phat sang o lop foreground (xem mipmap-*/ic_launcher_foreground.png).
     SUA (theo yeu cau nguoi dung "gaming hon"): dam mau hon ban cu de tuong
     phan manh voi day mau RGB neon (cyan-hong-tim) o lop foreground moi. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="76dp"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#241041"
        android:centerColor="#150826"
        android:endColor="#04010A" />
</shape>
