<?xml version="1.0" encoding="utf-8"?>
<!-- Nen icon adaptive: gradient toa tron tu tim dam am (giua) ra gan den
     (mep ngoai) - tao cam giac "hao quang" phia sau cac goc ngam QR va nut
     ban phim phat sang o lop foreground (xem mipmap-*/ic_launcher_foreground.png). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="76dp"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#1A0A2E"
        android:centerColor="#100620"
        android:endColor="#05020A" />
</shape>
