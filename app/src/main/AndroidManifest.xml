<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- THEM (theo yeu cau nguoi dung: "boc no lai khong cho no tat" - chong
         he thong "giet" tien trinh ban phim nen bang CODE thay vi chi dua
         vao nguoi dung tu tay tat toi uu pin): can 3 quyen nay de chay
         [KeepAliveService] (Foreground Service uu tien thap) giu TIEN
         TRINH cua ca ban phim o muc do quan trong cao hon, giam kha nang
         bi He Dieu Hanh tu dong giet khi thieu RAM (LMK - Low Memory
         Killer) - xem giai thich chi tiet trong KeepAliveService.kt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- THEM (theo yeu cau nguoi dung: "mic phải dùng mic riêng" - tu nghe/
         nhan dien NGAY trong chinh app, khong con uy quyen hoan toan cho app
         tro ly ao/Google qua Intent popup rieng nhu truoc - vi chat luong
         phu thuoc vao app do, khong on dinh). Can quyen nay de tu dung
         android.speech.SpeechRecognizer truc tiep (xem MicPermissionActivity.kt
         + phan xu ly Mic trong QrKeyboardService.kt). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- CHI can cho Android 9 (API 28) tro xuong, dung de luu anh "Chup anh
         nhanh" vao thu vien qua MediaStore - tu Android 10 (API 29) tro di,
         Scoped Storage cho phep ghi vao MediaStore.Images ma KHONG can xin
         quyen nay, nen gioi han maxSdkVersion de khong lam nguoi dung may
         moi bi hoi quyen luu tru khong can thiet. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!-- SUA LOI (tinh nang nhap lieu bang giong noi luon bao "may khong ho
         tro" du may co cai Google/tro ly ao): tu Android 11 (API 30), he
         thong AN MAC DINH moi app/component khac khoi tam nhin cua app nay
         (package visibility) - [resolveActivity()]/[startActivity()] trong
         VoiceInputActivity.kt se KHONG "thay" duoc app xu ly
         RecognizerIntent.ACTION_RECOGNIZE_SPEECH (vd Google) NEU khong khai
         bao truoc o day, DU may co cai san. App nay target API 34 (chac
         chan bi anh huong) nen BAT BUOC phai co khai bao nay. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".QrKeyboardApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="QR Keyboard"
        android:theme="@style/Theme.QRKeyboard">
        <!-- Activity huong dan nguoi dung bat ban phim (xin quyen Camera roi
             chuyen toi man Cai dat he thong de bat ban phim) - KHONG con la
             man LAUNCHER nua (theo yeu cau nguoi dung: bam icon app gio mo
             thang toi SettingsActivity ben duoi). Van giu lai activity nay
             (khong xoa) phong khi can dung lai luong huong dan nay sau nay -
             hien khong con noi nao trong code goi toi no nua. -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Activity toi gian, CHI dung de hien hop thoai xin quyen Camera
             he thong (Android bat buoc phai gan hop thoai nay voi mot
             Activity). Khong con chua camera/preview/khung quet nao ca -
             toan bo giao dien quet gio nam trong QrKeyboardService duoi dang
             mot View noi (xem showQrOverlay() trong QrKeyboardService.kt). -->
        <activity
            android:name=".QrCameraPermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity="com.example.qrkeyboard.qrpermission" />

        <!-- THEM (theo yeu cau nguoi dung: "mic phải dùng mic riêng"): cung
             mau voi QrCameraPermissionActivity o tren, CHi de xin quyen
             RECORD_AUDIO - xem MicPermissionActivity.kt. -->
        <activity
            android:name=".MicPermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity="com.example.qrkeyboard.micpermission" />

        <!-- THEM (theo yeu cau nguoi dung, tinh nang nhap lieu bang giong
             noi): Activity toi gian, CHI dung de mo man hinh nhan dien giong
             noi cua he thong (xem giai thich chi tiet trong
             VoiceInputActivity.kt). Cung mau voi QrCameraPermissionActivity
             o tren. -->
        <activity
            android:name=".VoiceInputActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity="com.example.qrkeyboard.voiceinput" />

        <!-- SUA LOI nguoi dung phan anh ("ten app luc cai/sau khi cai bi
             sai, khong phai QR Keyboard"): activity nay TRUOC DAY co
             android:label="Cài đặt" RIENG - vi day la man LAUNCHER (icon
             app tren man hinh chinh tro thang vao day), label rieng do se
             GHI DE len ten hien thi cua CHINH ICON APP (thanh "Cài đặt"
             thay vi "QR Keyboard" ke thua tu <application> o tren) - la
             nguyen nhan icon/ten app hien sai. BO han label rieng nay di,
             de no TU KE THUA dung "QR Keyboard" tu <application>. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- THEM (theo yeu cau nguoi dung: dat hinh nen bang anh cho ban
             phim): man hinh cat anh - dung THEO KE THUA "Theme.QRKeyboard"
             tu <application> (khong can khai bao rieng, giong SettingsActivity
             o tren) vi day la 1 man hinh HIEN THI BINH THUONG, TOAN MAN
             HINH (khac voi 3 Activity "trong suot" phia tren chi de xin
             quyen he thong). Xem BackgroundCropActivity.kt. -->
        <activity
            android:name=".BackgroundCropActivity"
            android:exported="false" />

        <!-- Dich vu ban phim (Input Method Service) -->
        <service
            android:name=".QrKeyboardService"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true"
            android:label="QR Keyboard">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- THEM (theo yeu cau nguoi dung: "boc no lai khong cho no tat"):
             Foreground Service uu tien THAP, chi de GIU tien trinh cua ca
             ban phim o muc do quan trong CAO HON trong mat He Dieu Hanh
             (giam kha nang bi Low Memory Killer tu dong giet khi thieu
             RAM) - xem giai thich chi tiet + gioi han THAT SU cua ky thuat
             nay trong KeepAliveService.kt. foregroundServiceType="specialUse"
             la loai BAT BUOC phai khai bao tu Android 14 (API 34) cho cac
             Foreground Service KHONG khop loai chuan nao (nhac/vi tri/dong
             bo...) - property canh no giai thich LY DO su dung, theo dung
             yeu cau cua Google Play. -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Giu tien trinh ban phim khong bi he thong tu dong giet nen, dam bao go duoc lien tuc khong bi gian doan giua chung" />
        </service>

        <!-- SUA LOI (crash "app tu tat khi chuyen man" - FileUriExposedException):
             app target API 34 (xem app/build.gradle) nen tu Android 7.0 (API
             24) tro len, he thong CAM tuyet doi truyen "file://" Uri qua
             Intent sang app khac (vd khi bam "Chia se Excel" o SettingsActivity,
             nhanh Android < 10 dung Uri.fromFile() truoc day) - lam CRASH
             ngay khi man hinh chia se cua he thong hien len. FileProvider
             nay tao "content://" Uri AN TOAN thay the (xem
             SettingsActivity.doExport() va res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
