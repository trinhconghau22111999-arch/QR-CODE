<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- CHI can cho Android 9 (API 28) tro xuong, dung de luu anh "Chup anh
         nhanh" vao thu vien qua MediaStore - tu Android 10 (API 29) tro di,
         Scoped Storage cho phep ghi vao MediaStore.Images ma KHONG can xin
         quyen nay, nen gioi han maxSdkVersion de khong lam nguoi dung may
         moi bi hoi quyen luu tru khong can thiet. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="QR Keyboard"
        android:theme="@style/Theme.QRKeyboard">
        <!-- Activity chinh: huong dan nguoi dung bat ban phim -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity toi gian, CHI dung de hien hop thoai xin quyen Camera
             he thong (Android bat buoc phai gan hop thoai nay voi mot
             Activity). Khong con chua camera/preview/khung quet nao ca -
             toan bo giao dien quet gio nam trong QrKeyboardService duoi dang
             mot View noi (xem showQrOverlay() trong QrKeyboardService.kt). -->
        <activity
            android:name=".QrCameraPermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity="com.example.qrkeyboard.qrpermission" />

        <!-- Man Cai dat rieng cua app (mau sac, gioi han quet trung lap,
             du lieu quet hom nay + xuat/chia se Excel) - mo tu nut "Cai dat"
             tren trang Ky hieu cua ban phim. taskAffinity rieng de khong bi
             gop chung task voi ban phim (mo tu Context cua Service). -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Cài đặt"
            android:theme="@style/Theme.QRKeyboard"
            android:taskAffinity="com.example.qrkeyboard.settings" />

        <!-- Dich vu ban phim (Input Method Service) -->
        <service
            android:name=".QrKeyboardService"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true"
            android:label="QR Keyboard">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>
</manifest>
